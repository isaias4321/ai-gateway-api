# Copie para ".env". NUNCA suba o .env real para o GitHub.

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Chaves que os CLIENTES do seu gateway devem enviar no header x-api-key.
# Não são as chaves da OpenAI/Anthropic — são chaves suas, para controlar
# quem pode usar este gateway. Pode ter várias, separadas por vírgula.
GATEWAY_API_KEYS=dev-key

# Chaves reais dos provedores de IA (defina pelo menos uma para os
# endpoints de chat funcionarem)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rate limiting: N requisições por janela de tempo, por chave de API
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# Cache de respostas não-streaming
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500
